<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 Message Center"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Wähle zwischen sofortigen Einzelalarmen oder gebündelten Sammelbenachrichtigungen (Digest)."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Notification Mode Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. Benachrichtigungs-Modus"
            android:textColor="@color/card_border_highlight"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgNotifMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbModeIndividual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="⚡ Einzelbenachrichtigung (Sofort pro Modell)"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbModeDigest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="📦 Sammelbenachrichtigung (AI Digest: Alle Modelle gebündelt)"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </RadioGroup>

        <!-- Digest Interval Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="2. Sammel-Intervall (Digest)"
            android:textColor="@color/card_border_highlight"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llIntervalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnInt1h"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary_background"
                android:text="1 Std"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnInt2h"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:text="2 Std"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnInt4h"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary_background"
                android:text="4 Std"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnIntDaily"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary_background"
                android:text="Täglich"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Smart Options -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="3. Schwellenwerte &amp; Ruhezeiten"
            android:textColor="@color/card_border_highlight"
            android:textSize="13sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbQuietHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🌙 Ruhezeit einhalten (23:00 - 07:00 Uhr stumm)"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cbEarlyWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="⚠️ Frühwarnung bei &lt; 15% (Limit fast erschöpft)"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- Notification History Feed -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="4. Ereignis-Feed &amp; Benachrichtigungs-Log"
            android:textColor="@color/card_border_highlight"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llEventLogContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#0A0D12"
            android:orientation="vertical"
            android:padding="8dp" />

        <!-- Actions -->
        <Button
            android:id="@+id/btnSendTestDigest"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/button_secondary_background"
            android:text="📦 Test-Sammelbenachrichtigung senden"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelMessageCenter"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary_background"
                android:text="Schließen"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSaveMessageCenter"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:text="Speichern"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
